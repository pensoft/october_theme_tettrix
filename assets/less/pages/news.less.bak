// ===========================================================================
//  TETTRIX news (redesign)
//  ---------------------------------------------------------------------------
//  New `tx-` markup for both views of pages/news.htm: the index (filter chips
//  + card grid) and the article (wide cover, 820px measure, share row).
//  The DeCrises rules above still target the old .news-list / .news-card
//  markup, which this page no longer emits - they are left in place because
//  pages/blog.htm and the events pages still render it.
// ===========================================================================

.tx-page {
    padding: 120px @tx-gutter 0;
    background: @tx-white;

    .breakpoint-large-down({
        padding: 110px @tx-gutter-md 0;
    });
    .breakpoint-medium-down({
        padding: 100px @tx-gutter-sm 0;
    });
}

.tx-page-head {
    max-width: @tx-container;
    margin: 0 auto 44px;
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.tx-page-title {
    margin: 0;
    font-family: @tx-font-display;
    font-size: @tx-h1-size;
    font-weight: 700;
    line-height: @tx-h1-lh;
    letter-spacing: @tx-h1-ls;
    color: @tx-ink;

    .breakpoint-large-down({
        font-size: 40px;
        line-height: 44px;
        letter-spacing: -0.8px;
    });
    .breakpoint-medium-down({
        font-size: 32px;
        line-height: 36px;
        letter-spacing: -0.4px;
    });
}

// -- Category filter chips --------------------------------------------------
.tx-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    a {
        display: inline-flex;
        align-items: center;
        height: 36px;
        padding: 0 16px;
        border: 1px solid @tx-ink-18;
        border-radius: @tx-radius-pill;
        color: @tx-ink-72;
        font-family: @tx-font-display;
        font-size: @tx-label-size;
        font-weight: 600;
        text-decoration: none;
        .transition(~"border-color @{tx-speed} ease, color @{tx-speed} ease, background @{tx-speed} ease");

        &:hover,
        &:focus {
            border-color: @tx-orange;
            color: @tx-orange;
        }

        &.active {
            background: @tx-ink;
            border-color: @tx-ink;
            color: @tx-white;
        }
    }
}

// -- Index grid -------------------------------------------------------------
.tx-news-grid {
    max-width: @tx-container;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;

    .breakpoint-large-down({
        grid-template-columns: repeat(2, minmax(0, 1fr));
    });
    .breakpoint-medium-down({
        grid-template-columns: minmax(0, 1fr);
    });
}

.tx-pagination {
    max-width: @tx-container;
    margin: 56px auto 0;

    ul.pagination {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
        justify-content: center;

        li {
            list-style: none;
        }

        a,
        span {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 40px;
            height: 40px;
            padding: 0 12px;
            border: 1px solid @tx-ink-18;
            border-radius: @tx-radius-xs;
            color: @tx-ink-72;
            font-family: @tx-font-display;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
        }

        a:hover,
        a:focus {
            border-color: @tx-orange;
            color: @tx-orange;
        }

        .active span {
            background: @tx-ink;
            border-color: @tx-ink;
            color: @tx-white;
        }

        .disabled span {
            opacity: .4;
        }
    }
}

// -- Article ----------------------------------------------------------------
.tx-article {
    background: @tx-white;

    &__cover {
        max-width: 1000px;
        margin: 0 auto;
        padding: 56px 24px 0;

        figure {
            margin: 0;
            height: 460px;
            border-radius: @tx-radius-lg;
            overflow: hidden;
            background: @tx-hero-black;

            .breakpoint-large-down({
                height: 340px;
            });
            .breakpoint-medium-down({
                height: 220px;
            });

            img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
        }
    }

    &__caption {
        margin-top: 12px;
        color: @tx-ink-40;
        font-family: @tx-font-body;
        font-size: 13px;
        line-height: 21px;
    }

    &__inner {
        max-width: 820px;
        margin: 0 auto;
        padding: 46px 24px 40px;
    }

    &__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    &__title {
        margin: 22px 0 0;
        font-family: @tx-font-display;
        font-size: @tx-h1-size;
        font-weight: 700;
        line-height: @tx-h1-lh;
        letter-spacing: @tx-h1-ls;
        color: @tx-ink;

        .breakpoint-large-down({
            font-size: 40px;
            line-height: 44px;
            letter-spacing: -0.8px;
        });
        .breakpoint-medium-down({
            font-size: 30px;
            line-height: 35px;
            letter-spacing: -0.4px;
        });
    }

    &__lead {
        margin-top: 26px;
        color: @tx-ink-72;
        font-size: @tx-lead-size;
        line-height: @tx-lead-lh;
        font-weight: 400;

        .breakpoint-medium-down({
            font-size: 18px;
            line-height: 29px;
        });
    }

    // The body is CKEditor output, so element selectors have to do the work -
    // there are no classes to hook onto.
    &__body {
        margin-top: 40px;
        font-family: @tx-font-body;
        font-size: @tx-body-size;
        line-height: @tx-body-lh;
        color: @tx-ink-78;

        p {
            margin: 0 0 24px;
        }

        h2 {
            margin: 40px 0 16px;
            font-family: @tx-font-display;
            font-size: @tx-h2-size;
            line-height: @tx-h2-lh;
            font-weight: 700;
            letter-spacing: -0.4px;
            color: @tx-ink;
        }

        h3 {
            margin: 32px 0 14px;
            font-family: @tx-font-display;
            font-size: 22px;
            line-height: 28px;
            font-weight: 700;
            color: @tx-ink;
        }

        a {
            color: @tx-orange;
            text-decoration: underline;

            &:hover,
            &:focus {
                color: @tx-orange-link;
            }
        }

        ul,
        ol {
            margin: 0 0 24px;
            padding-left: 24px;
        }

        li {
            margin-bottom: 10px;
        }

        img {
            max-width: 100%;
            height: auto;
            border-radius: @tx-radius-sm;
        }

        blockquote {
            margin: 32px 0;
            padding-left: 22px;
            border-left: 3px solid @tx-orange;
            color: @tx-ink-72;
            font-family: @tx-font-display;
            font-size: 20px;
            line-height: 32px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0 0 24px;

            th,
            td {
                padding: 10px 12px;
                border: 1px solid @tx-line;
                text-align: left;
            }
        }
    }

    &__rule {
        margin-top: 48px;
        height: 1px;
        background: @tx-line-soft;
    }

    &__share {
        margin-top: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    &__share-label {
        font-size: @tx-label-size;
        font-weight: 700;
        letter-spacing: 0.4px;
        color: @tx-ink;
    }

    &__share-links {
        display: flex;
        align-items: center;
        gap: 10px;

        a {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            border: 1px solid @tx-ink-18;
            display: flex;
            align-items: center;
            justify-content: center;
            color: @tx-ink;
            .transition(~"border-color @{tx-speed} ease, color @{tx-speed} ease, transform @{tx-speed} ease");

            &:hover,
            &:focus {
                color: @tx-orange-hover;
                border-color: rgba(241, 130, 51, 0.55);
                transform: translateY(-2px);
            }
        }

        svg {
            fill: currentColor;
        }
    }
}

// -- Related strip ----------------------------------------------------------
.tx-related {
    padding: 0 @tx-gutter 130px;

    .breakpoint-large-down({
        padding: 0 @tx-gutter-md 90px;
    });
    .breakpoint-medium-down({
        padding: 0 @tx-gutter-sm 70px;
    });

    &__inner {
        max-width: @tx-container;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    &__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;

        .breakpoint-large-down({
            grid-template-columns: repeat(2, minmax(0, 1fr));
        });
        .breakpoint-medium-down({
            grid-template-columns: minmax(0, 1fr);
        });
    }
}

// -- Back link --------------------------------------------------------------
.tx-back-bar {
    max-width: 1000px;
    margin: 0 auto;
    padding: 110px 24px 0;
}

.tx-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: @tx-ink-72;
    font-family: @tx-font-display;
    font-size: @tx-label-size;
    font-weight: 600;
    text-decoration: none;

    &:hover,
    &:focus {
        color: @tx-orange;
    }

    svg {
        stroke: currentColor;
    }
}

// -- Empty state ------------------------------------------------------------
.tx-empty {
    max-width: @tx-container;
    margin: 0 auto;
    padding: 40px 0 0;
    color: @tx-ink-62;
    font-size: @tx-copy-size;
}
